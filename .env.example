# Avanthi Attendance & Parent Alerts — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to source control.
# All secrets must be provided via environment; no plaintext in source.

# --- Django ---
# Generate a unique Django secret key before starting the application.
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
INTERNAL_IPS=127.0.0.1

# --- Database ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=avanthi_sms
POSTGRES_USER=avanthi
# Set a unique secret locally before starting Docker Compose. Do not reuse this file's placeholder.
POSTGRES_PASSWORD=

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- SMS Gateway ---
# SIMULATOR mode is default. Set SMS_MODE=live and configure gateway ONLY after
# completing all setup steps and explicit administrator activation in-app.
SMS_MODE=simulator

# Gateway settings (leave blank in simulator mode)
# OPENSMS_HOST=       # e.g. 192.168.1.100 — LAN IP of Android phone/modem
# OPENSMS_PORT=9292
# OPENSMS_API_KEY_REF=OPENSMS_SECRET  # name of env var holding the actual key
# OPENSMS_SECRET=     # actual bearer token (populate separately; never log)

# --- Institute ---
INSTITUTE_TIMEZONE=Asia/Kolkata
PHONE_REGION=IN

# --- Email (for password reset only; configure SMTP) ---
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_USE_TLS=false
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# --- Security ---
CSRF_COOKIE_SECURE=false
SESSION_COOKIE_SECURE=false
# Set both to true when running behind HTTPS
# Comma-separated list of trusted origins for CSRF (required on Vercel), e.g.:
# CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app

# --- Serverless (Vercel) ---
# VERCEL is set automatically by the Vercel runtime; do not set it locally.
# POSTGRES_SSLMODE defaults to "require" on Vercel (hosted Postgres needs TLS).
# REDIS_URL=locmem:// disables Redis and uses in-process cache (fine for small sites).

# --- File uploads ---
MEDIA_ROOT=/app/media
MAX_UPLOAD_MB=10
